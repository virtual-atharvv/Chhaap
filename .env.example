# Copy to .env and fill locally. NEVER commit a real .env or real secrets.
# Names only; the server has safe development fallbacks where noted.

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
PUBLIC_BASE_URL=http://localhost:4000
LOG_LEVEL=info

# --- Database --------------------------------------------------------------
# memory = tests/local-only; postgres = required in production.
DB_MODE=memory
DATABASE_URL=postgresql://chhaap:change_me@localhost:5432/chhaap

# --- Payments --------------------------------------------------------------
# simulated = local/test only; production refuses simulated.
PAYMENTS_MODE=simulated
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
WEBHOOK_MAX_AGE_SECONDS=900
ORDER_EXPIRY_MINUTES=15
PAYMENT_LINK_TTL_MINUTES=15

# --- Auth & secrets --------------------------------------------------------
# Generate strong unique values in production.
JWT_SECRET=
AGENT_TOKEN_PEPPER=
OTP_PEPPER=
REFRESH_TOKEN_PEPPER=
FILE_URL_SECRET=
RATE_LIMIT_ENABLED=true
TURNSTILE_SECRET=

# --- WhatsApp --------------------------------------------------------------
# mock = offline tests/dev; cloud = Meta Cloud API (required in production).
WHATSAPP_MODE=mock
WHATSAPP_API_VERSION=v21.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_PLATFORM_NUMBER=
WA_SESSION_TTL_MINUTES=30
WA_MESSAGE_RETENTION_DAYS=30

# --- Uploads & files -------------------------------------------------------
MAX_UPLOAD_MB=50
MAX_PAGES=500
CHHAAP_DATA_DIR=
FILE_URL_TTL_SECONDS=300

# --- Print agent (shop PC) -------------------------------------------------
CHHAAP_SERVER_URL=http://localhost:4000
CHHAAP_AGENT_NAME=Shop PC Agent
CHHAAP_PAIRING_CODE=
CHHAAP_AGENT_ID=
CHHAAP_AGENT_TOKEN=
CHHAAP_SUMATRA_PATH=
# Development only. Never enable on a real shop PC.
CHHAAP_VIRTUAL_PRINTER=0
CHHAAP_PRINT_OUTPUT_DIR=

# --- Observability ---------------------------------------------------------
SENTRY_DSN=
PRINTER_HEARTBEAT_TIMEOUT_MS=60000
