{
  "name": "chhaap-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test",
    "smoke": "node apps/api/scripts/smoke.js",
    "admin": "pnpm --filter @chhaap/api admin",
    "dev:api": "pnpm --filter @chhaap/api dev",
    "dev:agent": "pnpm --filter @chhaap/agent dev",
    "demo:whatsapp": "pnpm --filter @chhaap/api demo:whatsapp",
    "db:migrate": "pnpm --filter @chhaap/db migrate"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "typescript": "^5.6.3"
  }
}
